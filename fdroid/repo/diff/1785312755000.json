itteen omilta antureilta.\n\nKalenteri, porautuva analytiikka ja painopäiväkirja kuvaajineen. Halutessasi harjoituksen yhteenveto kirjoittuu puhelimen kalenteriin.\n\nKaikki data pysyy laitteella. Varmuuskopio on yksi JSON-tiedosto, jonka voit itse siirtää minne haluat — ja josta kaikki palautuu uuteen puhelimeen."}, "icon": {"en-US": {"name": "/com.longshore.mysports/en-US/icon_HrU5D2wgGJnlOSYvjzi2SclKIlDlFYjm-nBYhw1FU68=.png", "sha256": "1eb5390f6c201899e539262f8f38b649c94a2250e51588e6fa7058870d4553af", "size": 50025}}, "preferredSigner": "ec42e13fb0fbcddb5ba410ae1a4b65693f140877724c60fd1a7b6115f0388954"}, "versions": {"b413f8ab1c84a1a03eab44877acc3e5a419c46420590e76c35faa5eb4de0852e": {"added": 1785325751000, "file": {"name": "/com.longshore.mysports_10000.apk", "sha256": "b413f8ab1c84a1a03eab44877acc3e5a419c46420590e76c35faa5eb4de0852e", "size": 25455086}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["ec42e13fb0fbcddb5ba410ae1a4b65693f140877724c60fd1a7b6115f0388954"]}, "usesPermission": [{"name": "android.permission.ACCESS_BACKGROUND_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACTIVITY_RECOGNITION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.READ_EXTERNAL_STORAGE"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"n
oid.permission.USE_FINGERPRINT"}, {"name": "com.longshore.myid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}}}}, "com.longshore.myimprovementideas": {"metadata": {"added": 1785765560000, "categories": ["Perhe"], "lastUpdated": 1785765560000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyImprovementIdeas"}, "summary": {"en-US": "Kerro mikä mättää — sovellus tietää itse missä olit"}, "description": {"en-US": "Palautteen antaminen perheen sovelluksista yhdellä napautuksella, puhumalla.\n\nKun jokin sovellus ärsyttää tai siitä puuttuu jotain, avaa palaute suoraan siitä sovelluksesta ja kerro asiasi ääneen. Sovellus liittää mukaan itse sen mitä muuten pitäisi selittää: mikä sovellus, mikä versio, mikä näkymä, mitä juuri ennen tapahtui ja millainen puhelin. Sitä ei tarvitse muistaa eikä kirjoittaa.\n\nKaikki annetut palautteet ovat yhdessä aikajanassa: kuuntele uudelleen, katso mitä kontekstia lähti mukaan ja merkitse käsitellyksi kun asia on hoidettu.\n\nÄäni ja konteksti pysyvät puhelimessa. Mitään ei lähetetä verkkoon eikä pilveen — palautteet haetaan USB-johdolla tai perheen omaan holviin MyFilesin kautta."}, "icon": {"en-US": {"name": "/com.longshore.myimprovementideas/en-US/icon_Ver7sTsZcwxACd8Afk1Mf9G_5COo0iAg2xxCp08qwhY=.png", "sha256": "55eafbb13b19730c4009df007e4d4c7fd1bfe423a8d22020db1c42a74f2ac216", "size": 20676}}, "preferredSigner": "e62d42281a61145323184dbc280ab8654b103e29f3202e132a348096081cb209"}, "versions": {"bbfcdc0f72d33d41f2d7f1b2a0929a0ced436ad6679775636a70e3f41f55595b": {"added": 1785765560000, "file": {"name": "/com.longshore.myimprovementideas_100.apk", "sha256": "bbfcdc0f72d33d41f2d7f1b2a0929a0ced436ad6679775636a70e3f41f55595b", "size": 2816248}, "manifest": {"versionName": "0.1.0", "versionCode": 100, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["e62d42281a61145323184dbc280ab8654b103e29f3202e132a348096081cb209"]}, "usesPermission":
 {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.mycalllog.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mycompany": {"metadata": {"added": 1786004248000, "categories": ["Työ"], "lastUpdated": 1786014981000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyCompany"}, "summary": {"en-US": "Longshore Oy — velvoitteet, viralliset tiedot ja kuittitilanne yhdessä paikassa"}, "description": {"en-US": "Yhtiön tiedot ja lakisääteiset määräpäivät puhelimessa.\n\nAvautuu Velvoitteet-näkymään: se mikä maksaa jos sen unohtaa. Tilinpäätös kaupparekisteriin, rekisteritietojen vuosivahvistus, YEL-tarpeen selvitys — jokaisesta määräpäivä, sääntö josta se johtuu ja laiminlyönnin hinta euroina.\n\nTiedot-näkymässä on kaikki mitä lomakkeet kysyvät: nimi, Y-tunnus, osoite, puhelin, toimialaluokka, tilikausi, sähköpostit ja tunnukset. Napautus kopioi kentän.\n\nJokainen tieto kantaa mukanaan tilansa: lukittu, valittu, odottaa vai ei varmistettu. Arvio ei näytä faktalta — kyseenalainen puhelinnumero kantaa varauksensa, ja Y-tunnus odottaa kunnes PRH antaa sen.\n\nSovellus ei tee kirjanpitoa. Se kertoo mikä puuttuu."}, "icon": {"en-US": {"name": "/com.longshore.mycompany/en-US/icon_5J_JI9vrnL6xdD-cGw3gihFCFLGVNptteCKCE2VR2fo=.png", "sha256": "e49fc923dbeb9cbeb1743f9c1b0de08a114214b195369b6d782282136551d9fa", "size": 30309}}, "preferredSigner": "c6a5793f6093935f5376c87ccfc433fa594b297b772331c713e3670d2458204e"}, "versions": {"6b24890fca3efd17baa62efc31195418b8076726be102bba2b7d58ed218440e4": {"added": 1786014981000, "file": {"name": "/com.longshore.mycompany_10001.apk", "sha256": "6b24890fca3efd17baa62efc31195418b8076726be102bba2b7d58ed218440e4", "size": 3025406}, "manifest": {"versionName": "1.0.1", "versionCode": 10001, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 3
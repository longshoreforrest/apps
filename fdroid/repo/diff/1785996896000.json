dbcef58e7938e32dfe8fda78297349cf7c1103bd980444678019634be5d9b2", "size": 3917993}, "manifest": {"versionName": "1.17.0", "versionCode": 11700, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.permission.TAGS"}, {"name": "com.longshore.mysphere.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mytranscripts": {"metadata": {"added": 1786000936000, "categories": ["Perhe"], "lastUpdated": 1786000936000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyTranscripts"}, "summary": {"en-US": "Nauhoitettu keskustelu luettavaksi ja kuunneltavaksi — puhujittain, aikaleimoine"}, "description": {"en-US": "Selain puheelle. Litteroitu keskustelu avautuu luettavaksi dokumentiksi: rivit puhujittain omanvärisinä kuplina, aikaleiman napautus hyppää nauhalla siihen kohtaan, ja toisto korostaa käynnissä olevan rivin. Yksi haku löytää sanan kaikista nauhoista — myös taivutetusta muodosta ja yhdyssanan sisältä.\n\nKeskustelun osapuolet näkyvät ihmisinä eivätkä merkkijonoina: puhuja voidaan sitoa MyID-tunnukseen, jolloin nauhan yläpuolella lukee kuka keskusteli kenen kanssa. Sovellus kertoo myös miten tunnistus tehtiin — nimi tulee äänestä ja MyID-sidos litteroijalta, eikä kumpikaan ole MyID:n vahvistus.\n\nLitteroinnin epävarmuutta ei piiloteta. Kytkin näyttää toisen litterointiajon rivin alla, ja litteroijan merkinnät ([?], [epäselvä]) korostetaan sen sijaan että ne siivottaisiin pois.\n\nSovellus ei nauhoita, ei litteroi eikä lähetä mitään pilveen. Se näyttää valmiit paketit, jotka tuodaan puhelimeen holvista — tyhjä kirjasto tarkoittaa, ettei tässä puhelimessa ole vielä nauhoja."}, "icon": {"en-US": {"name": "/com.longshore.mytranscripts/en-US/icon_2WYKwLPCd7d-14PQWvVKcmff-canaYMb98EsvXtpkBM=.png", "sha256": "d9660ac0b3c277b77ed783d05af54a7267dff9c6a769831bf7c12cbd7b699013", "size": 2479}}, "preferredSigner": "d73a36ca1cf319650f136181fb15d56575efd5188beb8ccdf5fdf8cabb914d49"}, "versions": {"6d0f1a3df57d74fb7386b9c697e4033feec38e9e9be22df4ca286e3bcbdf27be": {"added": 1786000936000, "file": {"name": "/com.longshore.mytranscripts_100.apk", "sha256": "6d0f1a3df57d74fb7386b9c697e4033feec38e9e9be22df4ca286e3bcbdf27be", "size": 2908587}, "manifest": {"versionName": "0.1.0", "versionCode": 100, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["d73a36ca1cf319650f136181fb15d56575efd5188beb8ccdf5fdf8cabb914d49"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.mytranscripts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshoreforrest.mythoughts": {"metadata": {"added": 1785992331000, "lastUpdated": 1785997000000}, "versions": {"00c499de853b5a5db5989d602be0f12b6e547fff700282c76d482b876f6181d2": null, "b1fcdda501e043b97952aa169b8e36c0ef8b8d55b0ff4a99055455e819a1f9d6": {"added": 1785997000000, "file": {"name": "/com.longshoreforrest.my
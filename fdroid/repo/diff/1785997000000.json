sion": 28}, {"name": "com.longshore.mydocumentscanner.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 28}]}}}}, "com.longshore.mytranscripts": {"metadata": {"added": 1786000936000, "categories": ["Perhe"], "lastUpdated": 1786000936000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyTranscripts"}, "summary": {"en-US": "Nauhoitettu keskustelu luettavaksi ja kuunneltavaksi — puhujittain, aikaleimoine"}, "description": {"en-US": "Selain puheelle. Litteroitu keskustelu avautuu luettavaksi dokumentiksi: rivit puhujittain omanvärisinä kuplina, aikaleiman napautus hyppää nauhalla siihen kohtaan, ja toisto korostaa käynnissä olevan rivin. Yksi haku löytää sanan kaikista nauhoista — myös taivutetusta muodosta ja yhdyssanan sisältä.\n\nKeskustelun osapuolet näkyvät ihmisinä eivätkä merkkijonoina: puhuja voidaan sitoa MyID-tunnukseen, jolloin nauhan yläpuolella lukee kuka keskusteli kenen kanssa. Sovellus kertoo myös miten tunnistus tehtiin — nimi tulee äänestä ja MyID-sidos litteroijalta, eikä kumpikaan ole MyID:n vahvistus.\n\nLitteroinnin epävarmuutta ei piiloteta. Kytkin näyttää toisen litterointiajon rivin alla, ja litteroijan merkinnät ([?], [epäselvä]) korostetaan sen sijaan että ne siivottaisiin pois.\n\nSovellus ei nauhoita, ei litteroi eikä lähetä mitään pilveen. Se näyttää valmiit paketit, jotka tuodaan puhelimeen holvista — tyhjä kirjasto tarkoittaa, ettei tässä puhelimessa ole vielä nauhoja."}, "icon": {"en-US": {"name": "/com.longshore.mytranscripts/en-US/icon_2WYKwLPCd7d-14PQWvVKcmff-canaYMb98EsvXtpkBM=.png", "sha256": "d9660ac0b3c277b77ed783d05af54a7267dff9c6a769831bf7c12cbd7b699013", "size": 2479}}, "preferredSigner": "d73a36ca1cf319650f136181fb15d56575efd5188beb8ccdf5fdf8cabb914d49"}, "versions": {"6d0f1a3df57d74fb7386b9c697e4033feec38e9e9be22df4ca286e3bcbdf27be": {"added": 1786000936000, "file": {"name": "/com.longshore.mytranscripts_100.apk", "sha256": "6d0f1a3df57d74fb7386b9c697e4033feec38e9e9be22df4ca286e3bcbdf27be", "size": 2908587}, "manifest": {"versionName": "0.1.0", "versionCode": 100, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["d73a36ca1cf319650f136181fb15d56575efd5188beb8ccdf5fdf8cabb914d49"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.mytranscripts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}
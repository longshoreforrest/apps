{"repo": {"timestamp": 1786020758000, "categories": {"Työ": {"name": {"en-US": "Työ"}}}}, "packages": {"com.longshore.mycalllog": {"metadata": {"added": 1785938094000, "lastUpdated": 1786013404000}, "versions": {"11c8c31d89c7efe3dd1b895782a548041247f709aa8f6ebe1697395a50b2fe46": null, "4a429e3d4ce4d6c0c6210ce915789b18860e89d97fb594193e18b3c55d9e9ac1": {"added": 1786013404000, "file": {"name": "/com.longshore.mycalllog_300.apk", "sha256": "4a429e3d4ce4d6c0c6210ce915789b18860e89d97fb594193e18b3c55d9e9ac1", "size": 3517323}, "manifest": {"versionName": "0.3.0", "versionCode": 300, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["7f51164c720bf58f7994a89cb9c73443a5678cd207f41e2403aea58f2689f28f"]}, "usesPermission": [{"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.mycalllog.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mycompany": {"metadata": {"added": 1786004248000, "categories": ["Työ"], "lastUpdated": 1786014981000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyCompany"}, "summary": {"en-US": "Longshore Oy — velvoitteet, viralliset tiedot ja kuittitilanne yhdessä paikassa"}, "description": {"en-US": "Yhtiön tiedot ja lakisääteiset määräpäivät puhelimessa.\n\nAvautuu Velvoitteet-näkymään: se mikä maksaa jos sen unohtaa. Tilinpäätös kaupparekisteriin, rekisteritietojen vuosivahvistus, YEL-tarpeen selvitys — jokaisesta määräpäivä, sääntö josta se johtuu ja laiminlyönnin hinta euroina.\n\nTiedot-näkymässä on kaikki mitä lomakkeet kysyvät: nimi, Y-tunnus, osoite, puhelin, toimialaluokka, tilikausi, sähköpostit ja tunnukset. Napautus kopioi kentän.\n\nJokainen tieto kantaa mukanaan tilansa: lukittu, valittu, odottaa vai ei varmistettu. Arvio ei näytä faktalta — kyseenalainen puhelinnumero kantaa varauksensa, ja Y-tunnus odottaa kunnes PRH antaa sen.\n\nSovellus ei tee kirjanpitoa. Se kertoo mikä puuttuu."}, "icon": {"en-US": {"name": "/com.longshore.mycompany/en-US/icon_5J_JI9vrnL6xdD-cGw3gihFCFLGVNptteCKCE2VR2fo=.png", "sha256": "e49fc923dbeb9cbeb1743f9c1b0de08a114214b195369b6d782282136551d9fa", "size": 30309}}, "preferredSigner": "c6a5793f6093935f5376c87ccfc433fa594b297b772331c713e3670d2458204e"}, "versions": {"6b24890fca3efd17baa62efc31195418b8076726be102bba2b7d58ed218440e4": {"added": 1786014981000, "file": {"name": "/com.longshore.mycompany_10001.apk", "sha256": "6b24890fca3efd17baa62efc31195418b8076726be102bba2b7d58ed218440e4", "size": 3025406}, "manifest": {"versionName": "1.0.1", "versionCode": 10001, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["c6a5793f6093935f5376c87ccfc433fa594b297b772331c713e3670d2458204e"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.mycompany.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "698664a1844b3614a947a0169be959fd00e7f1631ea8fb2dc2ec7794aae4e84a": {"added": 1786004248000, "file": {"name": "/com.longshore.mycompany_10000.apk", "sha256": "698664a1844b3614a947a0169be959fd00e7f1631ea8fb2dc2ec7794aae4e84a", "size": 3024245}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["c6a5793f6093935f5376c87ccfc433fa594b297b772331c713e3670d2458204e"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.mycompany.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myinvoice": {"metadata": {"lastUpdated": 1786017111000}, "versions": {"83beedee396e217cbb592303d8052c4f079169320dde7f333d4ad659cfc6cb35": {"added": 1786017111000, "
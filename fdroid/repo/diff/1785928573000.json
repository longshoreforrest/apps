n_2Mr1iN5cDomYlt0GnccWGYakDs7PGHAi7djdS16TDZI=.png", "sha256": "d8caf588de5c0e899896dd069dc7161986a40ececf187022edd8dd4b5e930d92", "size": 38928}}, "preferredSigner": "b0e61ae3e4ded97c0510550ea1d4fb841b2e44982842fa7e178d566ace8d6a76"}, "versions": {"bd3e1e6dedf661fa06acf459cb097d7156d674bf0514c86e5b4d982eb86613dc": {"added": 1785934718000, "file": {"name": "/com.longshore.myplaces_10000.apk", "sha256": "bd3e1e6dedf661fa06acf459cb097d7156d674bf0514c86e5b4d982eb86613dc", "size": 3468197}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["b0e61ae3e4ded97c0510550ea1d4fb841b2e44982842fa7e178d566ace8d6a76"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.myplaces.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myrelationships": {"metadata": {"added": 1785934718000, "lastUpdated": 1785934718000}, "versions": {"e520c922aeb47768fdbc1a3515174ff72788efd21ed8e9e26e94c5b47b8df57a": {"added": 1785934718000}, "f1aaad6c1c465b2c3e01df123380f470545388d38793e29fe1f2f82a7c32b07a": {"added": 1785934718000}}}, "com.longshore.myslides": {"metadata": {"added": 1785934719000, "lastUpdated": 1785934719000}, "versions": {"572ea2975ae005d3417da530dd9ad336ddf2ff4d225c1d7359728b308354e284": null, "0d37996855f312cb5ea1b623fecde787564d54433164607f00c669b70a539156": {"added": 1785934719000}, "42b82ec0a8b1066c5a57c5d043116ed9a6bf0fa177bb60a1657cf497f674da00": {"added": 1785934719000}}}, "com.longshore.mysms": {"metadata": {"added": 1785934719000, "lastUpdated": 1785934719000}, "versions": {"ca0803e0191e28b946382219acbefbc48f2cca8ea33c473378a143fb249a611f": {"added": 1785934719000}}}, "com.longshore.mysphere": {"metadata": {"added": 1785934719000, "lastUpdated": 1785934719000}, "versions": {"ec18a9f97bcbcdf6d9b92c8a2d04c1fdea6fd1b4c144dc89703df1dc1b73279a": null, "27f81d0e194ac47421b3d4baf08325663da6abc99041a1b8d61734915d93114d": null, "2559fa46d8a0a6a241a9e35dc10f039fc2afc9f4662f787d4ec375003479b4ea": {"added": 1785934719000, "file": {"name": "/com.longshore.mysphere_11200.apk", "sha256": "2559fa46d8a0a6a241a9e35dc10f039fc2afc9f4662f787d4ec375003479b4ea", "size": 3909525}, "manifest": {"versionName": "1.12.0", "versionCode": 11200, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.permission.TAGS"}, {"name": "com.longshore.mysphere.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "0285784c2352f3e998fa5a87c5edaea8e1a325b2e902f86ead487ece17bffcce": {"added": 1785934719000}}}, "com.longshore.mysports": {"metadata": {"added": 1785934720000, "lastUpdated": 1785934720000}, "versions": {"b413f8ab1c84a1a03eab44877acc3e5a419c46420590e76c35faa5eb4de0852e": {"added": 1785934720000}}}, "com.longshore.mytravel": {"metadata": {"added": 1785934720000, "categories": ["Perhe"], "lastUpdated": 1785934720000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyTravel"}, "summary": {"en-US": "Perheen matkat — haaveet, suunnitelmat ja muistot samassa paikassa"}, "description": {"en-US": "Matka on oma käsite: sillä on nimi, maisema, päivälaskuri ja tunnus jota käytetään kaikkialla muuallakin — MySpheren keskustelun aiheena, MyDecisionsin päätösketjuna ja kuvakansion nimenä.\n\nJokainen matka avautuu postikorttina, jossa on koko perheen toiveseinä: kuka toivoo mitä, ja mistä on tykätty. Ohi menneellä matkalla sama seinä on muistoseinä, ja kohdelista muuttuu kysymykseksi \"kävimmekö täällä\".\n\nSuunnitelma-välilehdellä ovat luvut lähdeviitteineen: hinnat, lennot, aikaikkunat. Päätökset-välilehti lukee saman matkan päätösketjun MyDecisionsista ja näyttää mikä on ratkaistavissa juuri nyt ja kenen vuoro on — päätökset tehdään siellä, ei tässä.\n\nKuvat menevät matkan omaan kansioon, josta MyFiles varmistaa ne holviin. Mitään ei lähetetä verkkoon: matkat ovat tiedostoja jaetussa Documents/MyTravel-kansiossa, ja agentti kirjoittaa samoja tiedostoja.\n\nMukana kolme oikeaa matkaa: Viro heinäkuussa (muisto), Thaimaa 2027 ja 20-vuotishääpäivä Veronassa."}, "icon": {"en-US": {"name": "/com.longshore.mytravel/en-US/icon_3YmPgpMvJLatHxCByvbA-SnDuOeHm7naV1AuwdxT3Io=.png", "sha256": "dd898f82932f24b6ad1f1081caf6c0f929c3b8e7879bb9da57502ec1dc53dc8a", "size": 5200}}, "preferredSigner": "e079f445255770aafca8c08e47709ff24455a43e373d129167ce45e79d6717ee"}, "versions": {"297da15480e32fbffd82d604cc7e453b5130a72766aa9d5653095e7fa62aa1b3": {"added": 1785934720000, "file": {"name": "/com.longshore.mytravel_10000.apk", "sha256": "297da15480e32fbffd82d604cc7e453b5130a72766aa9d5653095e7fa62aa1b3", "size": 2945431}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["e079f445255770aafca8c08e47709ff24455a43e373d129167ce45e79d6717ee"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.p
{"repo": {"timestamp": 1785992331000}, "packages": {"com.longshore.myid": {"metadata": {"added": 1785985818000, "lastUpdated": 1785990244000}, "versions": {"4c353755b55acc235e318edd5c61a3dad21cc9fef4d661e2d2c21f451a145987": null, "4cde819d7d9a9cbd09f6620603df77c35471be5347743124e73b82bab8976036": {"added": 1785990244000, "file": {"name": "/com.longshore.myid_11000.apk", "sha256": "4cde819d7d9a9cbd09f6620603df77c35471be5347743124e73b82bab8976036", "size": 21459192}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.10.0", "versionCode": 11000, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["0cda3388ca3c57d12d8c0b0fc26ee10652d21dcada02f8532a6e7a31f52d3f8b"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.NFC"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.SEND_SMS"}, {"name": "android.permission.RECEIVE_SMS"}, {"name": "android.permission.READ_SMS"}, {"name": "android.permission.USE_FINGERPRINT"}, {"name": "com.longshore.myid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}}}}, "com.longshore.myinvoice": {"metadata": {"added": 1785988592000, "categories": ["Perhe"], "lastUpdated": 1785988592000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyInvoice"}, "summary": {"en-US": "Saapuneet laskut talteen ja hyväksytyiksi — MyID:n aikaleimalla"}, "description": {"en-US": "Jokainen saapunut lasku talteen samaan paikkaan, päätös siitä samalla kertaa: hyväksyn vai hylkään.\n\nPaperilasku skannataan kameralla ilman että sovelluksesta tarvitsee poistua, ja sähköinen lasku otetaan tiedostoista PDF:nä. Vinossa oleva sivu käännetään napista, ja kierto tallentuu kuvaan — se seuraa arkistoon asti.\n\nSumma, eräpäivä, viitenumero, IBAN ja toimittaja luetaan sivulta puhelimessa. Virtuaaliviivakoodista saadut arvot ovat täsmällisiä, ja jokaisesta kentästä näkyy tuliko se viivakoodista, tekstistä vai arvauksena. Mitään ei lähetetä verkkoon luettavaksi.\n\nPäätökset tehdään ilman verkkoa koko pinolle, ja yksi MyID-vahvistus lukitsee erän: aikaleima tulee MyID:n palvelimelta eikä puhelimen kellosta, ja se sidotaan allekirjoituksella juuri niihin päätöksiin jotka teit. Vahvistettua laskua ei voi enää muuttaa.\n\nVahvistetut laskut menevät MyFilesin kautta holviin PDF:nä, jonka viimeinen sivu on hyväksyntätodiste, sekä koneluettavana todisteena. Omat ja Longshore Oy:n laskut eri haaroihin, joten yhtiön ostolaskut ovat erotettavissa kirjanpitoon ilman jälkikäteistä lajittelua."}, "icon": {"en-US": {"name": "/com.longshore.myinvoice/en-US/icon_BoxMzXO5A94obMgo5r2iPmhfASIwDrb4-wX7N6apHVw=.png", "sha256": "068c4ccd73b903de286cc828e6bda23e685f0122300eb6f8fb05fb37a6a91d5c", "size": 12879}}, "preferredSigner": "a2b791a9124bef46359eaaebb76207824c5ac506792b6b9806347dc4a2aa425e"}, "versions": {"8cdf4b0ae4580ec89d49c1a8bfdc4617cc6130a24f273876c25d8e3b44391030": {"added": 1785988592000, "file": {"name": "/com.longshore.myinvoice_10000.apk", "sha256": "8cdf4b0ae4580ec89d49c1a8bfdc4617cc6130a24f273876c25d8e3b44391030", "size": 9973672}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["a2b791a9124bef46359eaaebb76207824c5ac506792b6b9806347dc4a2aa425e"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 28}, {"name": "com.longshore.myinvoice.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 28}]}}}}, "com.longshore.mymindmaps": {"metadata": {"added": 1785982140000, "lastUpdated": 1785990371000}, "versions": {"cd5911b6d60761ad6780ceba96d8e1894f048a02bf52b29d8a607dceb01a69aa": null, "f460
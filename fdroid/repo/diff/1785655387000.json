android.permission.USE_FINGERPRINT"}, {"name": "com.longshore.myid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mysms": {"metadata": {"added": 1785665552000, "categories": ["Perhe"], "lastUpdated": 1785665552000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MySMS"}, "summary": {"en-US": "Kaikki tekstiviestit yhdessä haettavassa hakemistossa"}, "description": {"en-US": "Tekstiviesti on nykyään se kanava, jossa tulevat koodit, laskut, ajanvaraukset ja pakettien noutotunnukset. Ne kaikki ovat puhelimessa tallessa — mutta niitä ei löydä, koska viestisovelluksen haku ei osaa suomea.\n\nMySMS lukee puhelimessa jo olevat viestit ja tekee niistä hakemiston, josta löytää millä tahansa muistamallaan sanalla. Haku ymmärtää taivutuksen (\"lasku\" löytää \"laskutuksen\"), yhdyssanat (\"koodi\" löytää \"vahvistuskoodisi\") eikä välitä ääkkösistä. Kahdeksantuhannen viestin haku kestää millisekunteja.\n\nSovellus korvaa puhelimen oman viestisovelluksen kokonaan: se ottaa vastaan viestit, näyttää ilmoituksen josta voi vastata suoraan, lähettää viestit ja tallentaa ne puhelimen viestikantaan normaalisti. Vahvistuskoodin voi kopioida yhdellä napautuksella suoraan keskustelusta.\n\nViestit pysyvät puhelimessa. Mitään ei lähetetä verkkoon eikä pilveen."}, "icon": {"en-US": {"name": "/com.longshore.mysms/en-US/icon_jabCgby_CX_gwgiEpiXFG1VD9y8uBy8qj-hmvr1kOm0=.png", "sha256": "8da6c281bcbf097fe0c20884a625c51b5543f72f2e072f2a8fe866bebd643a6d", "size": 17738}}, "preferredSigner": "2a599b40235395ee71c4ced34c81d6981e50d144749ab9c41e9d39f4ea5123b0"}, "versions": {"ca0803e0191e28b946382219acbefbc48f2cca8ea33c473378a143fb249a611f": {"added": 1785665552000, "file": {"name": "/com.longshore.mysms_10000.apk", "sha256": "ca0803e0191e28b946382219acbefbc48f2cca8ea33c473378a143fb249a611f", "size": 2872269}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["2a599b402353
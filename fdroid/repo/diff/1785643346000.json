ll, "f2ede72e831fe6998bd7effb8d23e589f65c34c2ea94fedad104cfad33d33643": {"added": 1785647513000, "file": {"name": "/com.longshore.mymindmaps_10200.apk", "sha256": "f2ede72e831fe6998bd7effb8d23e589f65c34c2ea94fedad104cfad33d33643", "size": 3549329}, "manifest": {"versionName": "1.2.0", "versionCode": 10200, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["3a17515fdaa6c60f8a143d9fe6c3101fb67d9646f7fe2d5a27a7ba747dec6e88"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "com.longshore.mymindmaps.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mysphere": {"metadata": {"added": 1785560246000, "lastUpdated": 1785648058000, "summary": {"en-US": "Perheen puhelut ja agenttien viestit — yhdellä painalluksella"}, "description": {"en-US": "Soita perheenjäsenelle yhdellä painalluksella. Etusivu on perhe: näet kuka on tavoitettavissa, ja puhelu lähtee yhdestä napautuksesta.\n\nPuhelu alkaa äänenä ja videon voi kytkeä kesken puhelun. Videon laadun valitset itse — arkeen riittää 480p, joka näyttää puhelimen ruudulla terävältä eikä syö kaistaa.\n\nPuhelin soi vaikka sovellus olisi kiinni. Saapuvaan puheluun vastataan ilmoituksesta niin kuin mihin tahansa puheluun.\n\nHalutessasi puhelut tallentuvat automaattisesti — molempien ääni yhtenä tiedostona, ja vastapuoli näkee että tallennat. Tallenne menee samaan kansioon jota My Thoughts lukee, joten siitä saa litteroinnin puhelimen omalla prosessorilla ilman pilveä.\n\nViestit-välilehdellä näet mitä omat AI-agenttisi ovat saaneet aikaan: tila, tehtävä, kesto ja linkit — ja tarvittaessa koko raportti. Viesti tulee puhelimeen sekunnissa ja säilyy sen omalla levyllä.\n\nMukana on myös numeronäppäimistö, osoitekirja ja yhdistetty puheluhistoria, joten tavallisiin puheluihin ei tarvitse vaihtaa sovellusta."}}, "versions": {"11995c182df26a2caaaa40a87c875686c10440daa06e6232ba2b5c7637911821": null, "5df914740a2dfead9221b1586485798e2cc680e2343f73a7353e78905644700f": {"added": 1785648058000, "file": {"name": "/com.longshore.mysphere_10500.apk", "sha256": "5df914740a2dfead9221b1586485798e2cc680e2343f73a7353e78905644700f", "size": 3862185}, "manifest": {"versionName": "1.5.0", "versionCode": 10500, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.mysphere.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshoreforrest.mythoughts": {"metadata": {"added": 1785646301000, "lastUpdated": 1785648640000, "description": {"en-US": "Nauhoita ajatuksesi yhdellä napilla ja muuta ne tekstiksi suoraan puhelimessa.\n\nLitterointi tapahtuu laitteella eikä ääni lähde mihinkään. Suomelle käytetään suomeen hienosäädettyä Whisper large-v3 -mallia, englannille large-v3-turboa. Kieli tunnistetaan automaattisesti useasta kohdasta nauhoitusta.\n\nValmis transkripti näkyy heti ja sen voi kopioida tekstinä, aikaleimoilla, Markdownina tai muotoiltuna HTML:nä — jälkimmäinen liimautuu sähköpostiin muotoilut säilyttäen.\n\nNauhoitukset tallentuvat myös puhelimen jaettuun Music/MyThoughts-kansioon, joten ne säilyvät vaikka sovellus asennettaisiin uudelleen ja saat ne pois puhelimesta USB-johdolla. Mitään ei lähetetä pilveen."}}, "versions": {"7deb6f0b4cec928897e682046b57326b8f52b550ca3c9dca605527d34a3e593f": null, "c17318ae690c0c213306962fdaaf680383d713d33a1959d088b333213d619bb9": null, "33d9f87aa1d96abda7da02feb82d19aa7600aa1a573104c73aaa43c8c21beb2a": null, "be7e37b980bdec1cdcce8d4d5c127dab80231a932996aa350e0aabb0e2265812": {"added": 1785648640000, "file": {"name": "/com.longshoreforrest.mythoughts_502.apk", "sha256": "be7e37b980bdec1cdcce8d4d5c127dab80231a932996aa350e0aabb0e2265812", "size": 57636154}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.5.2", "versionCode": 502, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["a019fd952210785153e9abd822800f0b28d147b8d9b969e45ca4ad730c61987d"]}, "usesPermission": [{"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.READ_MEDIA_AUDIO"}, {"name": "android.permission.READ_MEDIA_IMAGES"}, {"name": "android.permission.READ_MEDIA_VIDEO"}, {"name": "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "andr
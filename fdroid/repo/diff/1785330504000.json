30ca3ce41eef5851f41e2009936ce0ef3c7b0a58a670a8fc88b2", "size": 11494}}, "preferredSigner": "96c2919acac70b1c29b96ea69edf482f689b4d32ab2d7d421f535bc70382c6b9"}, "versions": {"6a2d16386ea6e97c35bedfcd1eb81736d9026ba9206e79609218fc8dd2179824": {"added": 1785383290000, "file": {"name": "/com.longshore.myofficeexcel_10000.apk", "sha256": "6a2d16386ea6e97c35bedfcd1eb81736d9026ba9206e79609218fc8dd2179824", "size": 7255866}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["96c2919acac70b1c29b96ea69edf482f689b4d32ab2d7d421f535bc70382c6b9"]}, "usesPermission": [{"name": "com.longshore.myofficeexcel.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshoreforrest.mythoughts": {"metadata": {"added": 1785371455000, "categories": ["Perhe"], "lastUpdated": 1785378072000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "My Thoughts"}, "summary": {"en-US": "Sanele ajatuksesi ja litteroi ne puhelimessa — ilman pilveä"}, "description": {"en-US": "Nauhoita ajatuksesi yhdellä napilla ja muuta ne tekstiksi suoraan puhelimessa.\n\nLitterointi tapahtuu laitteella eikä ääni lähde mihinkään. Suomelle käytetään suomeen hienosäädettyä Whisper large-v3 -mallia, englannille large-v3-turboa. Kieli tunnistetaan automaattisesti useasta kohdasta nauhoitusta.\n\nValmis transkripti näkyy heti ja sen voi kopioida tekstinä, aikaleimoilla, Markdownina tai muotoiltuna HTML:nä — jälkimmäinen liimautuu sähköpostiin muotoilut säilyttäen.\n\nNauhoitukset tallentuvat myös puhelimen jaettuun kansioon, joten ne säilyvät vaikka sovellus asennettaisiin uudelleen. Halutessasi ne synkronoituvat Google Driveen."}, "icon": {"en-US": {"name": "/com.longshoreforrest.mythoughts/en-US/icon_J7_wTZYR8CJ7VPcRsTUFsT33dEL1XsjRErWFv8-p6pY=.png", "sha256": "27bff04d9611f0227b54f711b13505b13df77442f55ec8d112b585bfcfa9ea96", "size": 68548}}, "preferredS
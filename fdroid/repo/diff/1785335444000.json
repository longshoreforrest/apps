{"repo": {"timestamp": 1785376104000}, "packages": {"com.longshore.mymusic": {"metadata": {"lastUpdated": 1785371312000}, "versions": {"e1f567b26f4f8193bd7573c54f1a61030806a8f0a065a34fc8e347b6925f815b": {"added": 1785371312000, "file": {"name": "/com.longshore.mymusic_10100.apk", "sha256": "e1f567b26f4f8193bd7573c54f1a61030806a8f0a065a34fc8e347b6925f815b", "size": 5440787}, "manifest": {"versionName": "1.1.0", "versionCode": 10100, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["c694a204e72d9d57b65538b22f130a1e6f7526f912f7ca8127bae356d1776d67"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.USE_CREDENTIALS"}, {"name": "com.google.android.gms.permission.AD_ID"}, {"name": "android.permission.ACCESS_ADSERVICES_ATTRIBUTION"}, {"name": "android.permission.ACCESS_ADSERVICES_AD_ID"}, {"name": "android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE"}, {"name": "com.longshore.mymusic.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"}]}}}}, "com.longshoreforrest.mythoughts": {"metadata": {"added": 1785335940000, "categories": ["Perhe"], "lastUpdated": 1785376103000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "My Thoughts"}, "summary": {"en-US": "Sanele ajatuksesi ja litteroi ne puhelimessa — ilman pilveä"}, "description": {"en-US": "Nauhoita ajatuksesi yhdellä napilla ja muuta ne tekstiksi suoraan puhelimessa.\n\nLitterointi tapahtuu laitteella eikä ääni lähde mihinkään. Suomelle käytetään suomeen hienosäädettyä Whisper large-v3 -mallia, englannille large-v3-turboa. Kieli tunnistetaan automaattisesti useasta kohdasta nauhoitusta.\n\nValmis transkripti näkyy heti ja sen voi kopioida tekstinä, aikaleimoilla, Markdownina tai muotoiltuna HTML:nä — jälkimmäinen liimautuu sähköpostiin muotoilut säilyttäen.\n\nNauhoitukset tallentuvat myös puhelimen jaettuun kansioon, joten ne säilyvät vaikka sovellus asennettaisiin uudelleen. Halutessasi ne synkronoituvat Google Driveen."}, "icon": {"en-US": {"name": "/com.longshoreforrest.mythoughts/en-US/icon_J7_wTZYR8CJ7VPcRsTUFsT33dEL1XsjRErWFv8-p6pY=.png", "sha256": "27bff04d9611f0227b54f711b13505b13df77442f55ec8d112b585bfcfa9ea96", "size": 68548}}, "preferredSigner": "a019fd952210785153e9abd822800f0b28d147b8d9b969e45ca4ad730c61987d"}, "versions": {"ac40b70a0deb699300e0ff35878f52aee432bba23a1233eb73a316456a5aa00b": {"added": 1785376103000, "file": {"name": "/com.longshoreforrest.mythoughts_302.apk", "sha256": "ac40b70a0deb699300e0ff35878f52aee432bba23a1233eb73a316456a5aa00b", "size": 59457241}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.3.2", "versionCode": 302, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["a019fd952210785153e9abd822800f0b28d147b8d9b969e45ca4ad730c61987d"]}, "usesPermission": [{"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.READ_MEDIA_AUDIO"}, {"name": "android.permission.READ_MEDIA_IMAGES"}, {"name": "android.permission.READ_MEDIA_VIDEO"}, {"name": "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "androi
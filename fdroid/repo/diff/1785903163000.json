{"repo": {"timestamp": 1785922776000}, "packages": {"com.longshore.myapps": {"metadata": {"added": 1785222639000, "lastUpdated": 1785904342000}, "versions": {"eea891bf155c75b620643229de00d70856bbcc34ecfc759b9871f3468de8a529": null, "8222b2254a8cb5a9b28ea226b783260e2efd866ddc9b37fae179388444638ba7": {"added": 1785904342000, "file": {"name": "/com.longshore.myapps_10300.apk", "sha256": "8222b2254a8cb5a9b28ea226b783260e2efd866ddc9b37fae179388444638ba7", "size": 3263329}, "manifest": {"versionName": "1.3.0", "versionCode": 10300, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["d113b17c6878c0480d4d23e76f3968989cbde635d6ab47d9aca4c1c754b8f63c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.REQUEST_INSTALL_PACKAGES"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.myapps.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mycalllog": {"metadata": {"added": 1785914839000, "categories": ["Perhe"], "lastUpdated": 1785915733000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyCallLog"}, "summary": {"en-US": "Kuka soitti — ja kannattaako soittaa takaisin"}, "description": {"en-US": "Suurin osa puheluista tulee numeroista, joita ei tunnista. Puhelimen oma puheluloki näyttää niistä pelkän numeron, ja kertoo sen lisäksi vain sen mitä paikkatieto arvasi. Sen perusteella ei voi päättää soittaako takaisin.\n\nMyCallLog vastaa siihen kysymykseen. Se lukee puhelulokista jokaisen kentän omaan arkistoonsa — myös ne, jotka järjestelmä on jo ehtinyt karsia — ja lähettää tuntemattomat numerot läppärillä ajettavalle agentille selvitettäväksi. Agentti etsii numeron verkosta ja omista arkistoista, ja kirjoittaa takaisin vastauksen: kuka soittaja on, mitä hän todennäköisesti haluaa, ja kannattaako soittaa takaisin. Perustelu ja lähteet näkyvät samassa näkymässä.\n\nYksi nappi käynnistää selvityksen. Vastaus tulee ilmoituksena, ja lista kertoo värillä mitä tehdä: vihreä soita takaisin, keltainen voi odottaa, punainen älä soita.\n\nPuhelut pysyvät puhelimessa. Verkkoon lähtevät vain ne numerot, joita osoitekirja ei tunne — ei nimiä, ei perheen puheluita, ei kestoja."}, "icon": {"en-US": {"name": "/com.longshore.mycalllog/en-US/icon_7a2oE0IdVTFnsIfstcDH4txE6mob1o_Ge4O-_6sHT94=.png", "sha256": "edada813421d553167b087ecb5c0c7e2dc44ea6a1bd68fc67b83beffab074fde", "size": 25389}}, "preferredSigner": "7f51164c720bf58f7994a89cb9c73443a5678cd207f41e2403aea58f2689f28f"}, "versions": {"11c8c31d89c7efe3dd1b895782a548041247f709aa8f6ebe1697395a50b2fe46": {"added": 1785915733000, "file": {"name": "/com.longshore.mycalllog_101.apk", "sha256": "11c8c31d89c7efe3dd1b895782a548041247f709aa8f6ebe1697395a50b2fe46", "size": 3507927}, "manifest": {"versionName": "0.1.1", "versionCode": 101, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["7f51164c720bf58f7994a89cb9c73443a5678cd207f41e2403aea58f2689f28f"]}, "usesPermission": [{"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.mycalllog.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "6c18a0a6903c88e70415989317d6cd2f518a7a5d61fa3ec53dce92697d66ef28": {"added": 1785914839000, "file": {"name": "/com.longshore.mycalllog_100.apk", "sha256": "6c18a0a6903c88e70415989317d6cd2f518a7a5d61fa3ec53dce92697d66ef28", "size": 3507639}, "manifest": {"versionName": "0.1.0", "versionCode": 100, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["7f51164c720bf58f7994a89cb9c73443a5678cd207f41e2403aea58f2689f28f"]}, "usesPermission": [{"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.mycalllog.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myfiles": {"metadata": {"added": 1785859828000, "lastUpdated": 1785922760000}, "versions": {"cae4aa66e2f3527a2e7f80724e46d8a300b225590651de191ab726faa7feb7e7": null, "627a87fd50c412767aa6fa5b1dd7d647e7f7163ba8c4f7653ca91e620bb74397": {"added": 1785922760000, "file": {"name": "/com.longshore.myfiles_1900.apk", "sha256": "627a87fd50c412767aa6fa5b1dd7d647e7f7163ba8c4f7653ca91e620bb74397", "size": 3526330}, "manifest": {"versionName": "0.19.0", "versionCode": 1900, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["7fd81088d316717d8aa4b8e47efe6ef67119ee8ca6d82cb07128522ef003d133"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.MANAGE_EXTERNAL_STORAGE"}, {"name": "android.permission.READ_MEDIA_IMAGES"}, {"name": "android.permission.READ_MEDIA_VIDEO"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.longshore.myfiles.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myrelationships": {"metadata": {"added": 1785907458000, "categories": ["Perhe"], "lastUpdated": 1785917800000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyRelationships"}, "summary": {"en-US": "Perheesi ja avioliittosi kehinä — ja kehät kaikkien sovellusten käyttöön"}, "description": {"en-US": "Näyttää keitä me olemme: avioliitto kahtena limittäisenä kehänä ja perhe kiertoratana, jonka keskellä olet sinä. Kasvot tulevat MyID:n profiilikuvista, ja jokaisesta ihmisestä näkee suhteen sinuun, syntymäpäivän ja MyID-tunnisteet.\n\nSamalla se näyttää mitä \"Perhe\", \"Isä\" ja \"Äiti\" tarkoittavat jakovaihtoehtoina: sanat lasketaan sinun suunnastasi, ja kaikki perheen sovellukset lukevat ne samasta paikasta."}, "icon": {"en-US": {"name": "/com.longshore.myrelationships/en-US/icon_bDu_XlJ-RW8yHNvTL4HHWmbyjv18edmZCWAZA2GXSsM=.png", "sha256": "6c3bbf5e527e456f321cdbd32f81c75a66f28efd7c79d9990960190361974ac3", "size": 14922}}, "preferredSigner": "cd0262e20d506159c7dc93c32eae943a60f5add62198e8db8ebf9db3c749cc7f"}, "versions": {"e520c922aeb47768fdbc1a3515174ff72788efd21ed8e9e26e94c5b47b8df57a": {"added": 1785917800000, "file": {"name": "/com.longshore.myrelationships_10100.apk", "sha256": "e520c922aeb47768fdbc1a3515174ff72788efd21ed8e9e26e94c5b47b8df57a", "size": 3448660}, "manifest": {"versionName": "1.1.0", "versionCode": 10100, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["cd0262e20d506159c7dc93c32eae943a60f5add62198e8db8ebf9db3c749cc7f"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.longshore.myrelationships.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "f1aaad6c1c465b2c3e01df123380f470545388d38793e29fe1f2f82a7c32b07a": {"added": 1785907458000, "file": {"name": "/com.longshore.myrelationships_10000.apk", "sha256": "f1aaad6c1c465b2c3e01df123380f47054538
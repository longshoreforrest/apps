{"repo": {"timestamp": 1785648640000}, "packages": {"com.longshore.mycalendar": {"metadata": {"lastUpdated": 1785647532000}, "versions": {"21e2115b05eed323c69dd298c3a7fa50d8060ca78ee818d173a058c426fa50a9": {"added": 1785647532000, "file": {"name": "/com.longshore.mycalendar_10100.apk", "sha256": "21e2115b05eed323c69dd298c3a7fa50d8060ca78ee818d173a058c426fa50a9", "size": 3243423}, "manifest": {"versionName": "1.1.0", "versionCode": 10100, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["1d930a5c1da841fc7e0812ab284c95d3bb488ca6e2770fe0411af1a39af2fecf"]}, "usesPermission": [{"name": "com.longshore.permission.CALENDAR_SOURCE"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "com.longshore.mycalendar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mymindmaps": {"metadata": {"added": 1785158022000, "lastUpdated": 1785647513000}, "versions": {"b51f9963fa239328d9118bf06e64152f0eee6ac50c635296c1688edc655eea87": null, "f2ede72e831fe6998bd7effb8d23e589f65c34c2ea94fedad104cfad33d33643": {"added": 1785647513000, "file": {"name": "/com.longshore.mymindmaps_10200.apk", "sha256": "f2ede72e831fe6998bd7effb8d23e589f65c34c2ea94fedad104cfad33d33643", "size": 3549329}, "manifest": {"versionName": "1.2.0", "versionCode": 10200, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["3a17515fdaa6c60f8a143d9fe6c3101fb67d9646f7fe2d5a27a7ba747dec6e88"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "com.longshore.mymindmaps.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mysphere": {"metadata": {"added": 1785560246000, "lastUpdated": 1785648058000, "summary": {"en-US": "Perheen puhelut ja agenttien viestit — yhdellä painalluksella"}, "description": {"en-US": "Soita perheenjäsenelle yhdellä painalluksella. Etusivu on perhe: näet kuka on tavoitettavissa, ja puhelu lähtee yhdestä napautuksesta.\n\nPuhelu alkaa äänenä ja videon voi kytkeä kesken puhelun. Videon laadun valitset itse — arkeen riittää 480p, joka näyttää puhelimen ruudulla terävältä eikä syö kaistaa.\n\nPuhelin soi vaikka sovellus olisi kiinni. Saapuvaan puheluun vastataan ilmoituksesta niin kuin mihin tahansa puheluun.\n\nHalutessasi puhelut tallentuvat automaattisesti — molempien ääni yhtenä tiedostona, ja vastapuoli näkee että tallennat. Tallenne menee samaan kansioon jota My Thoughts lukee, joten siitä saa litteroinnin puhelimen omalla prosessorilla ilman pilveä.\n\nViestit-välilehdellä näet mitä omat AI-agenttisi ovat saaneet aikaan: tila, tehtävä, kesto ja linkit — ja tarvittaessa koko raportti. Viesti tulee puhelimeen sekunnissa ja säilyy sen omalla levyllä.\n\nMukana on myös numeronäppäimistö, osoitekirja ja yhdistetty puheluhistoria, joten tavallisiin puheluihin ei tarvitse vaihtaa sovellusta."}}, "versions": {"11995c182df26a2caaaa40a87c875686c10440daa06e6232ba2b5c7637911821": null, "5df914740a2dfead9221b1586485798e2cc680e2343f73a7353e78905644700f": {"added": 1785648058000, "file": {"name": "/com.longshore.mysphere_10500.apk", "sha256": "5df914740a2dfead9221b1586485798e2cc680e2343f73a7353e78905644700f", "size": 3862185}, "manifest": {"versionName": "1.5.0", "versionCode": 10500, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.mysphere.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshoreforrest.mythoughts": {"metadata": {"added": 1785646301000, "lastUpdated": 1785648640000, "description": {"en-US": "Nauhoita ajatuksesi yhdellä napilla ja muuta ne tekstiksi suoraan puhelimessa.\n\nLitterointi tapahtuu laitteella eikä ääni lähde mihinkään. Suomelle käytetään suomeen hienosäädettyä Whisper large-v3 -mallia, englannille large-v3-turboa. Kieli tunnistetaan automaattisesti useasta kohdasta nauhoitusta.\n\nValmis transkripti näkyy heti ja sen voi kopioida tekstinä, aikaleimoilla, Markdownina tai muotoiltuna HTML:nä — jälkimmäinen liimautuu sähköpostiin muotoilut säilyttäen.\n\nNauhoitukset tallentuvat myös puhelimen jaettuun Music/MyThoughts-kansioon, joten ne säilyvät vaikka sovellus asennettaisiin uudelleen ja saat ne pois puhelimesta USB-johdolla. Mitään ei lähetetä pilveen."}}, "versions": {"0e70ac5243bbb7867948df06ea2ccbcf04aedb2e5988d98ec366c8e295f460df": null, "9b39af2e66da12735ec1c6a1e31b318dfb62806ebdfcc5a0710a81dc39cdf5a9": null, "7deb6f0b4cec928897e682046b57326b8f52b550ca3c9dca605527d34a3e593f": null, "be7e37b980bdec1cdcce8d4d5c127dab80231a932996aa350e0aabb0e2265812": {"added": 1785648640000, "file": {"name": "/com.longshoreforrest.mythoughts_502.apk", "sha256": "be7e37b980bdec1cdcce8d4d5c127dab80231a932996aa350e0aabb0e2265812", "size": 57636154}, "manifest": {"nativecode
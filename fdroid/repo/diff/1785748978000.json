t palautteet ovat yhdessä aikajanassa: kuuntele uudelleen, katso mitä kontekstia lähti mukaan ja merkitse käsitellyksi kun asia on hoidettu.\n\nÄäni ja konteksti pysyvät puhelimessa. Mitään ei lähetetä verkkoon eikä pilveen — palautteet haetaan USB-johdolla tai perheen omaan holviin MyFilesin kautta."}, "icon": {"en-US": {"name": "/com.longshore.myimprovementideas/en-US/icon_Ver7sTsZcwxACd8Afk1Mf9G_5COo0iAg2xxCp08qwhY=.png", "sha256": "55eafbb13b19730c4009df007e4d4c7fd1bfe423a8d22020db1c42a74f2ac216", "size": 20676}}, "preferredSigner": "e62d42281a61145323184dbc280ab8654b103e29f3202e132a348096081cb209"}, "versions": {"bbfcdc0f72d33d41f2d7f1b2a0929a0ced436ad6679775636a70e3f41f55595b": {"added": 1785765560000, "file": {"name": "/com.longshore.myimprovementideas_100.apk", "sha256": "bbfcdc0f72d33d41f2d7f1b2a0929a0ced436ad6679775636a70e3f41f55595b", "size": 2816248}, "manifest": {"versionName": "0.1.0", "versionCode": 100, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["e62d42281a61145323184dbc280ab8654b103e29f3202e132a348096081cb209"]}, "usesPermission": [{"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "com.longshore.myimprovementideas.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mysphere": {"metadata": {"added": 1785648058000, "lastUpdated": 1785771385000}, "versions": {"2dfafed505f9461eeb3be3b2e4b11962622da8962d360eacb0202c54c0953cf9": null, "d5ca6bbf16fba64401b6637ff5b307933c55f1a9e3dfe98e620a502eca0e3fa2": {"added": 1785771385000, "file": {"name": "/com.longshore.mysphere_10601.apk", "sha256": "d5ca6bbf16fba64401b6637ff5b307933c55f1a9e3dfe98e620a502eca0e3fa2", "size": 3890305}, "manifest": {"versionName": "1.6.1", "versionCode": 10601, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha25
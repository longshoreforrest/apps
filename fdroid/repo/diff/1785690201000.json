{"repo": {"timestamp": 1785697052000}, "packages": {"com.longshore.myid": {"metadata": {"added": 1785689800000, "lastUpdated": 1785697052000}, "versions": {"3f500562e8cf697bc343c09802e701f76a67022c601a4140605142cdc08638a7": null, "3b8363e1c7c33bacfd9c7d5ae71275f154adf5bdf872a93be4542b7c74d1b52b": {"added": 1785697052000, "file": {"name": "/com.longshore.myid_10610.apk", "sha256": "3b8363e1c7c33bacfd9c7d5ae71275f154adf5bdf872a93be4542b7c74d1b52b", "size": 20760315}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.6.10", "versionCode": 10610, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["0cda3388ca3c57d12d8c0b0fc26ee10652d21dcada02f8532a6e7a31f52d3f8b"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.NFC"}, {"name": "android.permission.SEND_SMS"}, {"name": "android.permission.RECEIVE_SMS"}, {"name": "android.permission.READ_SMS"}, {"name": "android.permission.USE_FINGERPRINT"}, {"name": "com.longshore.myid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}}}}, "com.longshore.mysphere": {"metadata": {"added": 1785572156000, "lastUpdated": 1785692084000, "description": {"en-US": "Soita perheenjäsenelle yhdellä painalluksella. Etusivu on perhe: näet kuka on tavoitettavissa, ja puhelu lähtee yhdestä napautuksesta.\n\nPuhelu alkaa äänenä ja videon voi kytkeä kesken puhelun. Videon laadun valitset itse — arkeen riittää 480p, joka näyttää puhelimen ruudulla terävältä eikä syö kaistaa.\n\nPuhelin soi vaikka sovellus olisi kiinni. Saapuvaan puheluun vastataan ilmoituksesta niin kuin mihin tahansa puheluun.\n\nHalutessasi puhelut tallentuvat automaattisesti — molempien ääni yhtenä tiedostona, ja vastapuoli näkee että tallennat. Tallenne menee samaan kansioon jota My Thoughts lukee, joten siitä saa litteroinnin puhelimen omalla prosessorilla ilman pilveä.\n\nViestit-välilehti on keskustelunäkymä: yksi rivi per aihe, ja rivi avautuu koko kehityshistoriaksi — mitä pyysit, mitä agentti teki ja mikä versio siitä syntyi. Voit kommentoida kirjoittamalla tai sanelemalla; ääniviesti lähtee heti kuunneltavaksi ja litteroituu puhelimessa. Keskusteluun voi liittää muita perheenjäseniä.\n\nMukana on myös numeronäppäimistö, osoitekirja ja yhdistetty puheluhistoria, joten tavallisiin puheluihin ei tarvitse vaihtaa sovellusta."}}, "versions": {"96c9ae6f19cdcfb74139c3d8613f0528e0e840adf402eae90bc5c0f69b1414b8": null, "8de1160a3422ef802b6e63358a3756b1fb6c0fa93eca2abf15e217a97b10131e": {"added": 1785692084000, "file": {"name": "/com.longshore.mysphere_10600.apk", "sha256": "8de1160a3422ef802b6e63358a3756b1fb6c0fa93eca2abf15e217a97b10131e", "size": 3888441}, "manifest": {"versionName": "1.6.0", "versionCode": 10600, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.mysphere.D
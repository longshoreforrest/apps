ellä. Wilmaan ei kirjoiteta mitään."}, "icon": {"en-US": {"name": "/com.longshore.mywilma/en-US/icon_L5i-39kfQefzSVRlddY8Q3Pk721o_LO9EwsVCvE2h18=.png", "sha256": "2f98bedfd91f41e7f349546575d63c4373e4ef6d68fcb3bd130b150af136875f", "size": 8290}}, "preferredSigner": "6f2346ccb4a1e8fbc0c79e42f551788982d8d4beb4ea4481249a87eb35e6ff6c"}, "versions": {"493683fc4dcf8b28121bfe76e2842715131fb8703e60c30ee67557ed6fdb352a": {"added": 1785817067000, "file": {"name": "/com.longshore.mywilma_10002.apk", "sha256": "493683fc4dcf8b28121bfe76e2842715131fb8703e60c30ee67557ed6fdb352a", "size": 3287517}, "manifest": {"versionName": "1.0.2", "versionCode": 10002, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["6f2346ccb4a1e8fbc0c79e42f551788982d8d4beb4ea4481249a87eb35e6ff6c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.longshore.mywilma.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "6c4e8dbfee6d68148a5a4917fcf047a8720ea4a2c2c579f0f912555f9f49d01b": {"added": 1785816875000, "file": {"name": "/com.longshore.mywilma_10001.apk", "sha256": "6c4e8dbfee6d68148a5a4917fcf047a8720ea4a2c2c579f0f912555f9f49d01b", "size": 3287165}, "manifest": {"versionName": "1.0.1", "versionCode": 10001, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["6f2346ccb4a1e8fbc0c79e42f551788982d8d4beb4ea4481249a87eb35e6ff6c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.longshore.mywilma.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "f171f39b3f4579d468428e4058da2ae37cbacfc636f84774c4b06aa7b1c3065f": {"added": 1785787990000, "file": {"name": "/com.longshore.mywilma_10000.apk", "sha256": "f171f39b3f4579d468428e4058da2ae37cbacfc636f84774c4b06aa7b1c3065f", "size": 3285841}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer"
{"repo": {"timestamp": 1785680617000}, "packages": {"com.longshore.myapps": {"metadata": {"added": 1785222014000, "lastUpdated": 1785679248000}, "versions": {"4e8c6ae7c61bc9931d089d3f507ae28ebe36513d1269e015390160ce7848418f": null, "611962e1d637bb1b5329e0d4ffa82028e77cbe9ca9e557057416ffcd0e03bfc0": {"added": 1785679248000, "file": {"name": "/com.longshore.myapps_10200.apk", "sha256": "611962e1d637bb1b5329e0d4ffa82028e77cbe9ca9e557057416ffcd0e03bfc0", "size": 3258905}, "manifest": {"versionName": "1.2.0", "versionCode": 10200, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["d113b17c6878c0480d4d23e76f3968989cbde635d6ab47d9aca4c1c754b8f63c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.REQUEST_INSTALL_PACKAGES"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.longshore.myapps.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mydiagnostics": {"metadata": {"added": 1785672799000, "categories": ["Perhe"], "lastUpdated": 1785672799000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyDiagnostics"}, "summary": {"en-US": "Perheen sovellusten huolto — viat näkyviin ja korjattaviksi ilman käyntiä puheli"}, "description": {"en-US": "Kun perheen oma sovellus kaatuu, kukaan ei yleensä kerro siitä. Puhelin jää käteen, sovellus suljetaan, ja vika jää elämään — usein kuukausiksi.\n\nMyDiagnostics kerää perheen sovelluksista sen mitä ne tietävät itsestään: kaatumiset pinolistauksineen, jumit, muistin loppumiset ja sen mitä juuri ennen vikaa tapahtui. Tiedot kulkevat yhdelle valtuutetulle huoltoagentille, joka voi tutkia vian ja korjata sen — ilman että puhelinta tarvitsee tuoda kenellekään.\n\nPuhelin liitetään MyID:llä sormenjäljellä, eikä se tapahdu vahingossa. Yhteys näkyy aina ilmoituksena, sovelluksen etusivulla on loki jokaisesta agentin tekemästä komennosta, ja katkaisija on samalla ruudulla. Toimet jotka hävittävät tietoa kysyvät aina erikseen luvan puhelimen omistajalta.\n\nVain yksi ennalta nimetty agentti pystyy tähän: jokainen komento on allekirjoitettu, ja puhelin tarkistaa allekirjoituksen itse eikä luota palvelimeen."}, "icon": {"en-US": {"name": "/com.longshore.mydiagnostics/en-US/icon_CLMG9cP4RYjsNyDz1KARpT-Mfi5SQMo_Ls9sIZu3IWA=.png", "sha256": "08b306f5c3f84588ec3720f3d4a011a53f8c7e2e5240ca3f2ecf6c219bb72160", "size": 8450}}, "preferredSigner": "0cfb5f70f413b17bffa6f2bdf6469c9cb6b92735895fbeac668d9522966c20dd"}, "versions": {"2e82a4a27d4002bcc7dcf37390fe88b752515c3397952da17a25324bd2a8c626": {"added": 1785672799000, "file": {"name": "/com.longshore.mydiagnostics_10000.apk", "sha256": "2e82a4a27d4002bcc7dcf37390fe88b752515c3397952da17a25324bd2a8c626", "size": 3309236}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["0cfb5f70f413b17bffa6f2bdf6469c9cb6b92735895fbeac668d9522966c20dd"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "com.longshore.mydiagnostics.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myid": {"metadata": {"added": 1785670811000, "lastUpdated": 1785680617000}, "versions": {"b1738372ff5ebbf4259773f5fec8c9dad361f01050a2c11bd499ec2ed2a295bc": null, "6e4e70bd935d20529e7a78c6e030cdcc483f35f78dd395196bb884a64f22dc9d": null, "f9dc2e4be97ba5be0a84d1
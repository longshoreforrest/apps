2352f3e998fa5a87c5edaea8e1a325b2e902f86ead487ece17bffcce": {"added": 1785928572000, "file": {"name": "/com.longshore.mysphere_11100.apk", "sha256": "0285784c2352f3e998fa5a87c5edaea8e1a325b2e902f86ead487ece17bffcce", "size": 3907445}, "manifest": {"versionName": "1.11.0", "versionCode": 11100, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["2cd8e9139b5fc30a7646641faeb35562e10099a57d5904e3c2dfd73b1c4d6ca7"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "com.longshore.permission.TAGS"}, {"name": "com.longshore.mysphere.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.mytravel": {"metadata": {"added": 1785934235000, "categories": ["Perhe"], "lastUpdated": 1785934235000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyTravel"}, "summary": {"en-US": "Perheen matkat — haaveet, suunnitelmat ja muistot samassa paikassa"}, "description": {"en-US": "Matka on oma käsite: sillä on nimi, maisema, päivälaskuri ja tunnus jota käytetään kaikkialla muuallakin — MySpheren keskustelun aiheena, MyDecisionsin päätösketjuna ja kuvakansion nimenä.\n\nJokainen matka avautuu postikorttina, jossa on koko perheen toiveseinä: kuka toivoo mitä, ja mistä on tykätty. Ohi menneellä matkalla sama seinä on muistoseinä, ja kohdelista muuttuu kysymykseksi \"kävimmekö täällä\".\n\nSuunnitelma-välilehdellä ovat luvut lähdeviitteineen: hinnat, lennot, aikaikkunat. Päätökset-välilehti lukee saman matkan päätösketjun MyDecisionsista ja näyttää mikä on ratkaistavissa juuri nyt ja kenen vuoro on — päätökset tehdään siellä, ei tässä.\n\nKuvat menevät matkan omaan kansioon, josta MyFiles varmistaa ne holviin. Mitään ei lähetetä verkkoon: matkat ovat tiedostoja jaetussa Documents/MyTravel-kansiossa, ja agentti kirjoittaa samoja tiedostoja.\n\nMukana kolme oikeaa matkaa: Viro heinäkuussa (muisto), Thaimaa 2027 ja 20-vuotishääpäivä Veronassa."}, "icon": {"en-US": {"name": "/com.longshore.mytravel/en-US/icon_3YmPgpMvJLatHxCByvbA-SnDuOeHm7naV1AuwdxT3Io=.png", "sha256": "dd898f82932f24b6ad1f1081caf6c0f929c3b8e7879bb9da57502ec1dc53dc8a", "size": 5200}}, "preferredSigner": "e079f445255770aafca8c08e47709ff24455a43e373d129167ce45e79d6717ee"}, "versions": {"297da15480e32fbffd82d604cc7e453b5130a72766aa9d5653095e7fa62aa1b3": {"added": 1785934235000, "file": {"name": "/com.longshore.mytravel_10000.apk", "sha256": "297da15480e32fbffd82d604cc7e453b5130a72766aa9d5653095e7fa62aa1b3", "size": 2945431}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["e079f445255770aafca8c08e47709ff24455a43e373d129167ce45e79d6717ee"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "com.longshore.mytravel.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}
Version": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "com.longshore.mymindmaps.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.longshore.myplaces": {"metadata": {"added": 1785934477000, "categories": ["Perhe"], "lastUpdated": 1785934477000, "license": "Proprietary", "authorName": "Longshore", "name": {"en-US": "MyPlaces"}, "summary": {"en-US": "Meille tärkeät paikat — tarkka osoite, sijainti ja kuvat vuosien varrelta"}, "description": {"en-US": "Koti, mökit ja muut paikat jotka merkitsevät jotain — yhdessä listassa, tarkkoina tietoina. Jokaisesta paikasta näkyy täsmällinen osoite yhdellä napautuksella kopioitavana, sijainti kartalla ja ajo-ohje puhelimen omalla karttasovelluksella.\n\nKoordinaatti kertoo aina mitä se on: osoitepiste vai tien geometriasta laskettu arvio. Mökkitien numero ei ole kartalla, joten laskettu piste merkitään lasketuksi eikä esitetä osoitteena.\n\nMukana on näyte kuvakirjastosta samalta paikalta vuosien varrelta — ja rehellinen tieto siitä miten kuvat löytyivät ja mitä ei löytynyt.\n\nPaikan jakaminen tehdään kehänä: \"Perhe\" tai yksi ihminen. Jako ei vanhene, koska kehän jäsenyys luetaan aina MyID:stä. Vain paikan omistaja voi muuttaa sen jakoa."}, "icon": {"en-US": {"name": "/com.longshore.myplaces/en-US/icon_2Mr1iN5cDomYlt0GnccWGYakDs7PGHAi7djdS16TDZI=.png", "sha256": "d8caf588de5c0e899896dd069dc7161986a40ececf187022edd8dd4b5e930d92", "size": 38928}}, "preferredSigner": "b0e61ae3e4ded97c0510550ea1d4fb841b2e44982842fa7e178d566ace8d6a76"}, "versions": {"bd3e1e6dedf661fa06acf459cb097d7156d674bf0514c86e5b4d982eb86613dc": {"added": 1785934477000, "file": {"name": "/com.longshore.myplaces_10000.apk", "sha256": "bd3e1e6dedf661fa06acf459cb097d7156d674bf0514c86e5b4d982eb86613dc", "size": 3468197}, "manifest": {"versionName": "1.0.0", "versionCode": 10000, "usesSdk": {"minSdkVersion": 22, "targetSdkVersion": 34}, "signer": {"sha256": ["b0e61ae3e4ded97c0510550ea1d4fb841b2e44982842fa7e178d566ace8d